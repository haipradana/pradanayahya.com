# App
DEBUG=False
SECRET_KEY=change-me-to-a-secure-random-string

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-secure-password

# Database (PostgreSQL)
POSTGRES_USER=portfolio_user
POSTGRES_PASSWORD=change-me-to-a-secure-db-password
POSTGRES_DB=portfolio_db
DATABASE_URL=postgresql+asyncpg://portfolio_user:change-me-to-a-secure-db-password@portfolio-db:5432/portfolio_db

# BytePlus LLM
BYTEPLUS_API_KEY=your-byteplus-api-key
BYTEPLUS_BASE_URL=https://ark.ap-southeast.byteplusapi.com/api/v3/chat/completions
BYTEPLUS_MODEL=deepseek-v3-2-251201

# Qdrant
QDRANT_URL=qdrant.pradanayahya.com
QDRANT_API_KEY=your-qdrant-api-key
COLLECTION_NAME=portfolio_data

# CORS (comma-separated origins)
CORS_ORIGINS=["https://pradanayahya.com", "https://www.pradanayahya.com", "http://localhost:5173"]
